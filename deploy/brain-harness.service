[Unit]
Description=Brain Harness MCP server
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/var/www/brain-harness/server
# Written by the "Deploy server" GitHub workflow (the leading "-" means
# the service still starts before the first deploy has created it)
EnvironmentFile=-/var/www/brain-harness/server/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
