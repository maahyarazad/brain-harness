# Copy this file to .env and fill in your values. Never commit .env.

# Your Anthropic API key (the server reads it; the browser never sees it)
ANTHROPIC_API_KEY=

# Model used for chat and the LLM-powered tools
ANTHROPIC_MODEL=claude-sonnet-5-5

# Where the server listens
PORT=3000
HOST=127.0.0.1

# Browser origins allowed to call the API cross-origin (comma-separated).
# Leave empty for local development (the Vite proxy makes it same-origin).
CORS_ORIGIN=
